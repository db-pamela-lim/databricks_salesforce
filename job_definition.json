{
  "name": "EPA Air Quality — Full Pipeline",
  "description": "Port Pirie air quality demo pipeline: sample data → silver → gold → ML + advisories",
  "email_notifications": {
    "on_failure": ["pamela.lim@databricks.com"]
  },
  "job_clusters": [
    {
      "job_cluster_key": "pipeline_cluster",
      "new_cluster": {
        "spark_version": "15.4.x-scala2.12",
        "node_type_id": "i3.xlarge",
        "num_workers": 2,
        "data_security_mode": "SINGLE_USER",
        "spark_conf": {
          "spark.databricks.delta.preview.enabled": "true"
        }
      }
    }
  ],
  "tasks": [
    {
      "task_key": "sample_data",
      "description": "Populate bronze Delta tables with 3 years of synthetic monitoring data",
      "job_cluster_key": "pipeline_cluster",
      "notebook_task": {
        "notebook_path": "/Repos/pamela.lim@databricks.com/databricks_salesforce/notebooks/05_sample_data_generator",
        "base_parameters": {
          "catalog": "epa_air_quality"
        }
      }
    },
    {
      "task_key": "silver_transform",
      "description": "Cleanse, cast, resample and join all sources into silver.combined_hourly",
      "depends_on": [{ "task_key": "sample_data" }],
      "job_cluster_key": "pipeline_cluster",
      "notebook_task": {
        "notebook_path": "/Repos/pamela.lim@databricks.com/databricks_salesforce/notebooks/02_silver_transform",
        "base_parameters": {
          "catalog": "epa_air_quality"
        }
      }
    },
    {
      "task_key": "gold_analytics",
      "description": "Build rolling averages, permit status, exceedance log and monthly stats",
      "depends_on": [{ "task_key": "silver_transform" }],
      "job_cluster_key": "pipeline_cluster",
      "notebook_task": {
        "notebook_path": "/Repos/pamela.lim@databricks.com/databricks_salesforce/notebooks/03_gold_analytics",
        "base_parameters": {
          "catalog": "epa_air_quality"
        }
      }
    },
    {
      "task_key": "ml_and_advisories",
      "description": "Train breach predictor, score predictions, generate school advisories via ai_query",
      "depends_on": [{ "task_key": "gold_analytics" }],
      "job_cluster_key": "pipeline_cluster",
      "notebook_task": {
        "notebook_path": "/Repos/pamela.lim@databricks.com/databricks_salesforce/notebooks/04_ml_exceedance_prediction",
        "base_parameters": {
          "catalog": "epa_air_quality"
        }
      }
    }
  ]
}
